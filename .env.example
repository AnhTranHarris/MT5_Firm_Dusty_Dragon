# Never commit real credentials. Copy to .env locally.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# Safety: paper is the only supported initial mode.
TRADING_MODE=paper
BROKER_NAME=boforex
ACCOUNT_CURRENCY=USD
ACCOUNT_STARTING_BALANCE=10000
PRIMARY_TIMEFRAME=M15

# Paper execution sizing.
# Request 0.01 lots by default. The MT5 adapter must validate each symbol's
# volume_min and volume_step before creating an order and use the broker-valid
# minimum/step rather than submitting an invalid volume.
PAPER_LOT_SIZE=0.01

# Initial conservative paper-risk circuit breakers. Fixed-lot sizing still
# passes through these guards; a 0.01-lot order can be rejected if its stop
# distance or aggregate exposure breaches a safety limit.
RISK_PER_TRADE_PCT=0.25
MAX_OPEN_RISK_PCT=2.0
DAILY_DRAWDOWN_HALT_PCT=2.5
WEEKLY_DRAWDOWN_HALT_PCT=5.0

# Human-readable report delivery. Disabled until local credentials are added.
# Never commit a Gmail password/app password to GitHub.
REPORT_EMAIL_ENABLED=false
REPORT_EMAIL_RECIPIENT=forex.isekai@gmail.com
REPORT_SMTP_HOST=smtp.gmail.com
REPORT_SMTP_PORT=465
REPORT_SMTP_USERNAME=
REPORT_SMTP_PASSWORD=
