# Never commit real credentials. Copy to .env locally.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# Safety: paper is the only supported initial mode.
TRADING_MODE=paper
BROKER_NAME=boforex
ACCOUNT_CURRENCY=USD
ACCOUNT_STARTING_BALANCE=10000
PRIMARY_TIMEFRAME=M15

# Initial conservative paper-risk defaults; adjust in local .env later.
RISK_PER_TRADE_PCT=0.25
MAX_OPEN_RISK_PCT=2.0
DAILY_DRAWDOWN_HALT_PCT=2.5
WEEKLY_DRAWDOWN_HALT_PCT=5.0
